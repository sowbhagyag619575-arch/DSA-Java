class Solution {
    public int firstUniqChar(String s) {
        char c1[] = s.toCharArray();
     
         
        for(int i=0;i<c1.length;i++){
              boolean unique=true;
            for(int j=0;j<c1.length;j++){
                if(i!=j && c1[i]==c1[j]){
                    unique= false;
                    break;
                }
            }

            if(unique){
                return i;
            }
         
      }

           return -1;
        }
     
        
    }
